<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AuraFit" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/aura_accent_coral</item>
        <item name="colorPrimaryVariant">@color/aura_accent_coral</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/aura_accent_coral</item>
        <item name="colorSecondaryVariant">@color/aura_accent_coral</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Background Color -->
        <item name="android:windowBackground">@color/aura_background</item>
        <!-- Set the default font family (Download Inter or Poppins from Google Fonts and add to res/font) -->
        <!-- <item name="fontFamily">@font/poppins</item> -->
    </style>

    <style name="Theme.AuraFit" parent="Base.Theme.AuraFit" />
</resources>